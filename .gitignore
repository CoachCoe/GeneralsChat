# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
out/
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database
data/
*.db
*.sqlite

# Uploads
uploads/

# IDE and agent config
.vscode/
.idea/
# .dockerignore already excludes this; keep the two consistent so a local
# agent config cannot be committed by accident.
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Playwright output (failure screenshots and reports were committed as if
# they were source; upload them as CI artifacts instead)
test-results/
playwright-report/
blob-report/

# Prisma
src/generated/

# Temporary files
*.tmp
*.temp
e2e/.auth/

# Azure deployment config: names, and the only copy of the DB password.
deploy/azure/.env
deploy/azure/.provisioned

# Working documents: dated audit trails and superseded snapshots. They describe
# what was done rather than how the system works, so they are not part of what
# a stranger clones. The existing ones stay readable in git history at cc759fc;
# anything still open from them is an issue.
docs/audit/
docs/history/
