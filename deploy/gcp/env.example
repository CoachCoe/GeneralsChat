# Copy to deploy/gcp/.env and edit. Sourced by provision.sh, deploy.sh, ops.sh.
# This file is gitignored; it holds names, not secrets.

export PROJECT_ID=""
export REGION="us-central1"
export APP_NAME="generalschat"

# Artifact Registry repository holding both images.
export AR_REPO="${APP_NAME}"

export SERVICE_NAME="${APP_NAME}"
export MIGRATE_JOB_NAME="${APP_NAME}-migrate"
export OPS_JOB_NAME="${APP_NAME}-ops"

# Cloud SQL for PostgreSQL. Reached over the Cloud SQL unix socket, so the
# instance needs no public IP and the app needs no VPC connector.
export SQL_INSTANCE="${APP_NAME}-pg"
# db-f1-micro is not offered for every Postgres edition in every region; if
# provisioning rejects it, db-g1-small and db-custom-1-3840 are the next steps
# up. Postgres on Cloud SQL has no free tier -- this instance costs money from
# the moment it exists.
export SQL_TIER="db-g1-small"
export SQL_DATABASE="generalschat"
export SQL_USER="generalschat"
# Leave unset and provision.sh generates one and prints it once.
export SQL_PASSWORD=""

# Bucket mounted at /app/uploads. Attachments are student records and policy
# source documents; without this mount both are destroyed on every revision.
# Must be globally unique.
export UPLOADS_BUCKET="${APP_NAME}-uploads"

# The service account the service and jobs run as. Least privilege: Cloud SQL
# client, Secret Manager accessor, and object admin on the uploads bucket only.
export SERVICE_ACCOUNT="${APP_NAME}-run"

# Application secrets, stored in Secret Manager by provision.sh.
# Generate AUTH_SECRET with: openssl rand -base64 32
export AUTH_SECRET=""
export ANTHROPIC_API_KEY=""

# Optional model override. A retired id fails as a 404 at request time, which
# reaches the administrator as a generic 503, so pin one only with a reason.
export ANTHROPIC_MODEL=""

# NOTE: OPENAI_API_KEY is deliberately absent. Vector search also needs a
# reachable Chroma server, which this deployment does not provision, and
# retrieval works on the category-filtered keyword fallback without it. An
# advertised-but-ignored variable is worse than an absent one, because it reads
# as configured. Wire both up together or neither.
