# Database
# Prisma datasource is postgresql (prisma/schema.prisma). A `file:` URL is
# rejected outright by `npm run migrate` with P1012.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/generalschat?schema=public"

# Authentication (required). Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
# Set to the app's public origin in production.
NEXTAUTH_URL="http://localhost:3000"
# Needed when running behind a proxy or in a container.
AUTH_TRUST_HOST="true"

# AI Configuration - Claude (Primary LLM)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
# Model override. The default is claude-sonnet-5; pin a specific snapshot only
# if you have a reason to. A retired id fails as a 404 not_found_error at
# request time, which reaches the administrator as a generic 503.
# ANTHROPIC_MODEL="claude-sonnet-5"
# Route model calls at a gateway, a proxy, or a stub. Unset means the real API.
# The e2e suite sets this to its local stub so the run makes no billed calls.
# ANTHROPIC_BASE_URL=""

# AI Configuration - OpenAI (Embeddings only - Optional)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Vector Database - Chroma (Optional - uses keyword fallback if not configured)
# Run Chroma server locally: docker run -p 8000:8000 chromadb/chroma
CHROMA_URL="http://localhost:8000"
CHROMA_COLLECTION="policy_embeddings"

# File Storage
UPLOADS_DIR="./uploads"
MAX_FILE_SIZE="10485760"  # 10MB

# Logging. Defaults to debug in development and info otherwise.
# LOG_LEVEL="info"

# Development
NODE_ENV="development"
